# Только пример — скопируй в локальный .env и не коммить секреты.
BOT_TOKEN=
ADMIN_IDS=
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
# Пример для OpenAI; замени при выборе другого провайдера.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Число последних реплик (пользователь + ассистент).
AI_HISTORY_LIMIT=12
SYSTEM_PROMPT=Ты полезный ассистент. Отвечай кратко и по делу.
